# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (local: printed by `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Entra ID login gate (off until SIT approves; see README)
AUTH_ENABLED=false

# Shared secret the importer sends to /api/revalidate after publishing
REVALIDATE_SECRET=
